#!/usr/bin/env bash
# Floatfin wizard — a guided, skill-tiered tour from inside the terminal.
#
#   new to Linux?   step 1 -> the beginner tour
#   want a toolbox? step 2 -> the workbench
#   power user?     step 3 -> system power tools
#
# Run `float --cheatsheet` to print the whole thing, or `float help`.

set -u

CHEATSHEET=/usr/share/floatfin/cheatsheet.txt
COCKPIT_URL="https://localhost:9090"

banner() {
    printf '%s\n' \
        "╔══════════════════════════════════════════════════════════════╗" \
        "║           FLOATFIN · the wizard-fox terminal                 ║" \
        "║                                                              ║" \
        "║   new here?       step 1 →  the easy tour                    ║" \
        "║   set up shop?    step 2 →  the workbench                    ║" \
        "║   take control?   step 3 →  system power tools               ║" \
        "╚══════════════════════════════════════════════════════════════╝"
}

section() { # section <heading> — print one tiered chunk of the cheatsheet
    awk -v seek="$1" '
        BEGIN { show = 0 }
        /^### / { show = ($2 == seek) ? 1 : 0 }
        show    { print }
    ' "$CHEATSHEET"
}

beginner() {
    section beginner
    printf '\nPress enter to open the interactive GNOME Tour (or Ctrl-C to skip): '
    read -r _
    command -v gnome-tour >/dev/null 2>&1 && gnome-tour
}

workbench() {
    printf '%s\n' \
        "" \
        "Pick a tool:" \
        "  1) distrobox   — drop into a full distro container, share your files" \
        "  2) nix         — run any nixpkgs package (flakes are on)" \
        "  3) podman      — plain container workbench (rootless)" \
        "  4) cockpit     — open the admin web console" \
        "  5) show all    — print the workbench cheatsheet" \
        "  0) back"
    printf '> '
    read -r pick
    case "$pick" in
        1) distrobox enter fedora ;;  # enter auto-creates the container on first use
        2) nix run nixpkgs#hello ;;
        3) podman ps ;;
        4) xdg-open "$COCKPIT_URL" 2>/dev/null || echo "open $COCKPIT_URL in a browser" ;;
        5) section workbench ;;
        *) return ;;
    esac
}

power() {
    section power
}

menu() {
    banner
    printf '%s\n' \
        "" \
        "  wizard@floatfin — pick a path:" \
        "" \
        "  1) The easy tour         2) The workbench         3) System power tools" \
        "" \
        "  4) fastfetch (this machine)    q) quit" \
        ""
    printf '> '
}

set -f
loop=1
case "${1:-}" in
    help|--help|-h)
        banner
        printf '\n%s\n' "and there are 3 doors to walk through."; exit 0 ;;
    --cheatsheet|-c)
        cat "$CHEATSHEET"; exit 0 ;;
esac

while (( loop )); do
    menu
    read -r pick
    case "$pick" in
        1) beginner ;;
        2) workbench ;;
        3) power ;;
        4) command -v fastfetch >/dev/null 2>&1 && fastfetch --config /usr/share/ublue-os/fastfetch.jsonc || echo "no fastfetch on this island" ;;
        q|Q|0) loop=0 ;;
        *) echo "  ✗ not a door — try 1, 2, 3, 4 or q" ;;
    esac
done
exit 0