[Unit]
# Nix on an immutable root needs a writable /nix pointing at persistent
# storage. Fedora Atomic roots are read-only at boot, so the baked-in /nix
# directory (and the store it will bootstrap into) has to live on /var.
# /var/lib/nix is created by /usr/lib/tmpfiles.d/floatfin-nix.conf before this
# unit runs. Named floatfin-nix.mount (not nix.mount) so an upstream Fedora
# nix.mount can never collide with ours in the image.
Description=Nix store bind mount (/var/lib/nix → /nix)
After=local-fs.target
Requires=local-fs.target

[Mount]
What=/var/lib/nix
Where=/nix
Type=none
Options=bind

[Install]
WantedBy=local-fs.target