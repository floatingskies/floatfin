# Favorites only list native apps (RPM). No flatpaks are pinned to the dock:
# the image is flatpak-ready but ships nothing from Flathub.
[org.gnome.shell]
favorite-apps=['org.gnome.Nautilus.desktop','firefox.desktop','code.desktop']

[org.gnome.desktop.wm.preferences]
button-layout=':minimize,maximize,close'

[org.gnome.nautilus.icon-view]
default-zoom-level='small-plus'

[org.gnome.nautilus.preferences]
click-policy='single'
default-folder-viewer='icon-view'
migrated-gtk-settings=true
search-filter-time-type='last_modified'
show-create-link=true
show-delete-permanently=true

# Lean desktop: no transitions, improved perceived speed.
[org.gnome.desktop.interface]
clock-format='12h'
clock-show-weekday=true
color-scheme='prefer-dark'
enable-animations=false
show-battery-percentage=true
monospace-font-name='Intel One Mono 14'

[org.gnome.desktop.background]
picture-options='zoom'

[org.gtk.Settings.FileChooser]
sort-directories-first=true
startup-mode='cwd'

[org.gtk.gtk4.settings.file-chooser]
sort-directories-first=true

# Only keep the search providers that exist on this image; the rest are
# flatpaks we no longer ship (or background load we don't need).
[org.gnome.desktop.search-providers]
disabled=['org.gnome.Boxes.desktop','org.gnome.Calculator.desktop','org.gnome.Characters.desktop','org.gnome.Contacts.desktop','org.gnome.Maps.desktop','org.gnome.Music.desktop','org.gnome.Todo.desktop','org.gnome.Weather.desktop','org.gnome.clocks.desktop','org.gnome.seahorse.desktop','org.mozilla.firefox.desktop']

# File indexing is disabled for speed (see also optimize-gnome.sh which masks
# the Tracker services). Nautilus still works; full-text search is off.
[org.freedesktop.Tracker3.Miner.Files]
crawling-interval=-1
index-on-battery=false
index-recursive-directories=[]

[org.gnome.Ptyxis]
default-rows=32
default-columns=128